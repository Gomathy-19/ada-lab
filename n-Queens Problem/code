#include <stdio.h>
#define MAX 10
int board[MAX], n;
int isSafe(int row, int col) {
    for(int i = 0; i < row; i++) {
        if(board[i] == col)
            return 0;
        if(abs(board[i] - col) == abs(i - row))
            return 0;
    }
    return 1;
}
void printSolution() {
    printf("\nSolution:\n");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            if(board[i] == j)
                printf("Q ");
            else
                printf(". ");
        }
        printf("\n");
    }
}
void solveNQueens(int row) {

    if(row == n) {
        printSolution();
        return;
    }
    for(int col = 0; col < n; col++) {
        if(isSafe(row, col)) {
            board[row] = col;
            solveNQueens(row + 1);
        }
    }
}
int main() {

    printf("Enter number of queens: ");
    scanf("%d", &n);
    solveNQueens(0);
    return 0;
}
