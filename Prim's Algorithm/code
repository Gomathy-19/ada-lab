#include <stdio.h>

#define MAX 20
#define INF 999

int main() {
    int cost[MAX][MAX], visited[MAX];
    int n, i, j;
    int min, minCost = 0;
    int a, b, u, v;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost adjacency matrix:\n");

    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);

            if(cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }

    for(i = 0; i < n; i++) {
        visited[i] = 0;
    }

    visited[0] = 1;

    printf("\nEdges in Minimum Spanning Tree:\n");

    for(int edge = 0; edge < n - 1; edge++) {

        min = INF;

        for(i = 0; i < n; i++) {
            if(visited[i]) {
                for(j = 0; j < n; j++) {
                    if(!visited[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        a = u = i;
                        b = v = j;
                    }
                }
            }
        }

        printf("%d -- %d == %d\n", a, b, min);

        minCost += min;
        visited[b] = 1;
    }

    printf("\nMinimum Cost = %d\n", minCost);

    return 0;
}
