#include <stdio.h>
#define MAX 10
#define INF 999
int main() {
    int graph[MAX][MAX], dist[MAX][MAX];
    int n, i, j, k;
    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);
            if(i != j && graph[i][j] == 0)
                graph[i][j] = INF;
            dist[i][j] = graph[i][j];
        }
    }
    for(k = 0; k < n; k++) {
        for(i = 0; i < n; i++) {
            for(j = 0; j < n; j++) {

                if(dist[i][k] + dist[k][j] < dist[i][j]) {
                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }
    printf("\nAll Pairs Shortest Path Matrix:\n");
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {

            if(dist[i][j] == INF)
                printf("INF ");
            else
                printf("%d ", dist[i][j]);
        }
        printf("\n");
    }
    return 0;
}
