#include <stdio.h>

#define MAX 10

int main() {
    int graph[MAX][MAX], indegree[MAX];
    int n, i, j, count = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);
        }
    }

    for(i = 0; i < n; i++) {
        indegree[i] = 0;
    }

    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            if(graph[i][j] == 1) {
                indegree[j]++;
            }
        }
    }

    printf("\nTopological Ordering:\n");

    while(count < n) {

        for(i = 0; i < n; i++) {

            if(indegree[i] == 0) {

                printf("%d ", i);

                indegree[i] = -1;

                for(j = 0; j < n; j++) {
                    if(graph[i][j] == 1) {
                        indegree[j]--;
                    }
                }

                count++;
            }
        }
    }

    return 0;
}

